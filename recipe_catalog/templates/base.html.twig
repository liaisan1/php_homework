<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Каталог рецептов{% endblock %}</title>

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('style.css') }}">
    {% endblock %}
</head>
<body>

    <header class="site-header">
        <div class="header-content">
            <a href="{{ path('recipe_index') }}" class="site-logo">
                Мои рецепты
            </a>

            <nav class="site-nav">
                <a href="{{ path('recipe_index') }}">Главная</a>
                <a href="{{ path('recipe_new') }}">Добавить рецепт</a>
            </nav>
        </div>
    </header>

    {% block body %}
    {% endblock %}

</body>
</html>
