<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Генерация писем</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 40px;
        }

        .container {
            width: 600px;
            margin: auto;
            background-color: white;
            padding: 30px;
            border-radius: 10px;
        }

        h1 {
            text-align: center;
        }

        .user {
            background-color: #f5f5f5;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 5px;
        }

        h3 {
            margin-top: 0;
        }

        input {
            padding: 10px;
            margin: 5px 5px 5px 0;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button {
            padding: 10px 20px;
            background-color: #333;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: #555;
        }

        .button {
            text-align: center;
            margin-top: 20px;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Генерация писем</h1>

    <form method="POST" action="/emails/create">

        <div class="user">
            <h3>Пользователь 1</h3>

            <input type="text" name="names[]" placeholder="Имя" required>
            <input type="email" name="emails[]" placeholder="Email" required>
        </div>

        <div class="user">
            <h3>Пользователь 2</h3>

            <input type="text" name="names[]" placeholder="Имя" required>
            <input type="email" name="emails[]" placeholder="Email" required>
        </div>

        <div class="user">
            <h3>Пользователь 3</h3>

            <input type="text" name="names[]" placeholder="Имя" required>
            <input type="email" name="emails[]" placeholder="Email" required>
        </div>

        <div class="button">
            <button type="submit">Создать письма</button>
        </div>

    </form>

</div>

</body>
</html>