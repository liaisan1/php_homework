{% extends 'base.html.twig' %}

{% block title %}Календарь{% endblock %}

{% block body %}

<h1>Календарь</h1>

<table border="1">
    <tr>
        <th>Пн</th>
        <th>Вт</th>
        <th>Ср</th>
        <th>Чт</th>
        <th>Пт</th>
        <th>Сб</th>
        <th>Вс</th>
    </tr>

    <tr>

    {% for i in 1..firstDay - 1 %}
        <td></td>
    {% endfor %}

    {% for day in 1..days %}

        <td>{{ day }}</td>

        {% if (day + firstDay - 1) % 7 == 0 %}
            </tr><tr>
        {% endif %}

    {% endfor %}

    </tr>
</table>

{% endblock %}