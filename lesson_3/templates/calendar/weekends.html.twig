{% extends 'base.html.twig' %}

{% block title %}Календарь{% endblock %}

{% block body %}

<h1>Календарь</h1>

<table>
    <tr>
        <th>Пн</th>
        <th>Вт</th>
        <th>Ср</th>
        <th>Чт</th>
        <th>Пт</th>
        <th>Сб</th>
        <th>Вс</th>
    </tr>

    <tr>

    {% for i in 1..firstDay - 1 %}
        <td></td>
    {% endfor %}

    {% for day in daysList %}

        {% if day.weekDay >= 6 %}
            <td style="color: red">{{ day.number }}</td>
        {% else %}
            <td>{{ day.number }}</td>
        {% endif %}

        {% if (day.number + firstDay - 1) % 7 == 0 %}
            </tr><tr>
        {% endif %}

    {% endfor %}

    </tr>
</table>

{% endblock %}