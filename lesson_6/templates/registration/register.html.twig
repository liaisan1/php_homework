
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Регистрация</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 40px;
        }

        .container {
            width: 500px;
            max-width: 90%;
            margin: auto;
            background-color: white;
            padding: 30px;
            border-radius: 10px;
        }

        h1 {
            text-align: center;
        }

        .user {
            background-color: #f5f5f5;
            padding: 20px;
            margin-bottom: 15px;
            border-radius: 5px;
        }

        label {
            display: block;
            margin-top: 10px;
            margin-bottom: 5px;
        }

        input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
        }

        button {
            padding: 10px 20px;
            background-color: #333;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: #555;
        }

        .button {
            text-align: center;
            margin-top: 20px;
        }

        .form-error-message,
        .form-error {
            color: red;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Регистрация</h1>

    {{ form_start(registrationForm) }}

        {{ form_errors(registrationForm) }}

        <div class="user">

            {{ form_row(registrationForm.name) }}

            {{ form_row(registrationForm.email) }}

            {{ form_row(registrationForm.plainPassword) }}

        </div>

        <div class="button">
            <button type="submit">Зарегистрироваться</button>
        </div>

    {{ form_end(registrationForm) }}

</div>

</body>
</html>
